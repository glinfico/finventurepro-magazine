{
  "name": "AdPurchase",
  "type": "object",
  "properties": {
    "advertiser_name": {
      "type": "string"
    },
    "advertiser_email": {
      "type": "string"
    },
    "slot_label": {
      "type": "string"
    },
    "slot_position": {
      "type": "string"
    },
    "price_monthly": {
      "type": "number"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_price_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "cancelled"
      ],
      "default": "pending"
    },
    "ad_headline": {
      "type": "string"
    },
    "ad_link": {
      "type": "string"
    },
    "ad_copy": {
      "type": "string"
    },
    "campaign_start": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string",
      "enum": [
        "stripe",
        "paypal"
      ]
    },
    "paypal_order_id": {
      "type": "string"
    },
    "paypal_capture_id": {
      "type": "string"
    },
    "paypal_order_status": {
      "type": "string"
    }
  },
  "required": [
    "advertiser_email",
    "slot_label",
    "price_monthly"
  ]
}

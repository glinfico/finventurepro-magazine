{
  "name": "Article",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "finance",
        "economy",
        "insurance",
        "travel",
        "consulting",
        "retirement"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "intro": {
      "type": "string"
    },
    "body_json": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Hero image URL for the article"
    },
    "video_url": {
      "type": "string",
      "description": "YouTube or video URL to embed in the article"
    },
    "author": {
      "type": "string"
    },
    "read_time": {
      "type": "string"
    },
    "published_date": {
      "type": "string"
    },
    "is_published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "title",
    "section",
    "category"
  ]
}